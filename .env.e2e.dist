# =============================================================================
# Isolated Playwright E2E environment template (versioned sibling of .env.dist)
# =============================================================================
# Install:  cp .env.e2e.dist .env.e2e.local
# Or:       make ensure-e2e-env  (copies this file, overlays shared infra from
#           .env.local, then applies E2E_* overrides)
# Runtime:  Docker Compose `--env-file .env.e2e.local` (compose.e2e.yaml).
# Never commit .env.e2e.local. Isolation defaults: 9087/9461 / nowo_shell_e2e / Redis DB 3.
# =============================================================================

# Server (host ports → container 80/443)
SERVER_NAME=localhost
COMPOSE_PROJECT_NAME=nowo-shell-e2e
HTTP_PORT=9087
HTTPS_PORT=9461
HTTP3_PORT=9461
DEFAULT_URI=https://localhost:9461

# -----------------------------------------------------------------------------
# Vite / Pentatrion (Compose service `vite`, pnpm in the FrankenPHP image)
# Host port maps to container 5173; browser loads /build via HTTPS (Caddy proxy).
VITE_PORT=5179
VITE_DEV_SERVER_HOST=localhost
# Set to 1 on Docker Desktop / WSL if HMR misses file changes (polling).
# VITE_USE_POLLING=1

# -----------------------------------------------------------------------------
# FrankenPHP mode (classic | worker) — HTTP, NOT Messenger
# -----------------------------------------------------------------------------
# Coding implications: docs/ops/FRANKENPHP-CODING.md
#   classic              → boot per request
#   worker + RESET=false → shared Kernel; use ResetInterface (default, fastest)
#   worker + RESET=true  → clone Kernel per request (safer container, slower)
#
# After changing mode: `make restart` or `docker compose up -d` (recreate).
FRANKENPHP_MODE=worker
FRANKENPHP_WORKER_NUM=4
FRANKENPHP_LOOP_MAX=500
FRANKENPHP_RESET_KERNEL=false

# Xdebug: off | develop | debug | coverage
XDEBUG_MODE=off

# Symfony
###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=ChangeMePleaseUseARealSecret
APP_SHARE_DIR=var/share
# Only when TLS terminates in front of FrankenPHP/Caddy (comma-separated CIDRs or REMOTE_ADDR).
# Leave empty for default Compose (Caddy terminates TLS). See docs/PRODUCTION.md.
# SYMFONY_TRUSTED_PROXIES=
# SYMFONY_TRUSTED_HEADERS=x-forwarded-for,x-forwarded-proto
###< symfony/framework-bundle ###

# Default UI locale for bare public URLs (must be in enabled_locales).
# .env.dist ships English (`en`). Override in `.env.local` if needed (e.g. `es`).
DEFAULT_LOCALE=en

# -----------------------------------------------------------------------------
# MySQL (latest stable official: 9.7 — https://hub.docker.com/_/mysql)
# -----------------------------------------------------------------------------
MYSQL_VERSION=9.7
MYSQL_DATABASE=nowo_shell_e2e
MYSQL_USER=app
MYSQL_PASSWORD=!ChangeMe!
MYSQL_ROOT_PASSWORD=!ChangeMeRoot!

# Network shared with sibling projects (and developer.local.server/server / little-vps).
SHARED_DOCKER_NETWORK=server_network
# little-vps: SHARED_DOCKER_NETWORK=server_internal

# simple = primary only; replica = also start mysql-9.7.2-replica (Compose profile mysql-replica).
# Used by `make up-infra` / compose.infra.yaml (shared MySQL + Redis).
MYSQL_TOPOLOGY=simple

# Host reachable from the php container (no host-published DB ports — REQ-FP-006):
#   standalone (compose.yaml `database`) → database   ← default below
#   shared (compose.infra / compose.shared) → mysql-9.7.2-primary
#   little-vps                               → mysql-9.7.2-primary (+ SHARED_DOCKER_NETWORK=server_internal)
MYSQL_HOST=mysql-9.7.2-primary
MYSQL_PORT=3306
MYSQL_HOST_RO=mysql-9.7.2-primary
MYSQL_PORT_RO=3306

# --- Shared mode — put overrides in `.env.local` ---
# MYSQL_DATABASE=nowo_shell
# MYSQL_USER=app
# MYSQL_PASSWORD=!ChangeMe!
# MYSQL_HOST=mysql-9.7.2-primary
# MYSQL_HOST_RO=mysql-9.7.2-primary
# REDIS_HOST=redis-8.10.2

# Optional non-root app user bootstrap on an existing primary: make bootstrap-shared-db
# SHARED_MYSQL_ROOT_PASSWORD=

###> doctrine/doctrine-bundle ###
DATABASE_URL="mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@${MYSQL_HOST}:${MYSQL_PORT}/${MYSQL_DATABASE}?serverVersion=${MYSQL_VERSION}&charset=utf8mb4"
DATABASE_URL_RO="mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@${MYSQL_HOST_RO}:${MYSQL_PORT_RO}/${MYSQL_DATABASE}?serverVersion=${MYSQL_VERSION}&charset=utf8mb4"
# PHPUnit (`APP_ENV=test`) SQLite URL.
APP_TEST_DATABASE_URL="sqlite:////dev/shm/symfony-frankenphp-boilerplate-v2-phpunit.db"
###< doctrine/doctrine-bundle ###

# -----------------------------------------------------------------------------
# Redis (sessions, cache.app / rate limits) — compose.yaml `redis` (standalone)
# or compose.infra.yaml `redis-8.10.2` (shared). Define REDIS_* before REDIS_URL
# so Compose can interpolate without "variable is not set" warnings.
# REDIS_PASSWORD is owned by the shared Redis instance (server/ or compose.infra).
# Empty = no AUTH (local default). Outside dev/test AUTH is required (REQ-INFRA-SHARED-003).
# When set, do not leave REDIS_URL without userinfo. Never interpolate empty:
#   redis://:@host  ← forbidden
# -----------------------------------------------------------------------------
REDIS_VERSION=8.10.2
REDIS_HOST=redis-8.10.2
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/3
# When REDIS_PASSWORD is set (same value as server/.env / compose.infra):
# REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}
# Shared infra host (when MYSQL_HOST=mysql-9.7.2-primary):
# REDIS_HOST=redis-8.10.2

###> symfony/messenger ###
# Async queue in MySQL. Consumed by the Compose `messenger` service.
# Alternatives:
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://${REDIS_HOST}:${REDIS_PORT}
# With Redis AUTH (REQ-INFRA-SHARED-003): redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}
# Stream names belong in messenger.yaml (REQ-MESSENGER-001) — do not put /messages in the DSN path.
MESSENGER_TRANSPORT_DSN=redis://${REDIS_HOST}:${REDIS_PORT}?dbindex=3
###< symfony/messenger ###

# -----------------------------------------------------------------------------
# Field encryption (nowo-tech/doctrine-encrypt-bundle)
# -----------------------------------------------------------------------------
# Default: Halite key file at var/secrets/.Halite.default.key (auto-created).
# Production: generate once and persist the file, or switch the YAML profile to
# secret_key_env_var and set APP_ENCRYPT_KEY (Halite hex key from
# `bin/console doctrine:encrypt:generate-secret-key`).
# APP_ENCRYPT_KEY=

###> nowo-tech/site-backup-bundle ###
# Panel password hash for /_site_backup (required).
# Generate: docker compose exec php bin/console nowo:site-backup:hash-password
# Local default is for development only — FORBIDDEN in production
# (App\Setup\SiteBackupSecurityDefaultsGuard refuses to boot if unchanged).
SITE_BACKUP_PASSWORD_HASH='$2y$12$Y0N6Pfivo9cGw9rCLyrZwOvjMV5dFcWyn5EO.U4nnwX2kg05rRCtK'
# Shared secret for /setup (?token=… or X-Setup-Token). Documented local default below;
# YAML falls back to the same value when unset — gate stays on. FORBIDDEN in production.
SITE_SETUP_TOKEN=app-local-setup
###< nowo-tech/site-backup-bundle ###

###> nowo-tech/maintenance-mode-bundle ###
# Administration panel: /admin/maintenance (AuthKit + ROLE_ADMIN — no ops password).
# Preview the public 503 page without enabling downtime: /_maintenance_preview
# Optional legacy ops password gate (disabled in config):
# MAINTENANCE_PASSWORD_HASH=
###< nowo-tech/maintenance-mode-bundle ###

###> symfony/mailer ###
# Bootstrap / fallback only when Administration → Mailer has no DSN stored.
# Prefer saving the real DSN encrypted under /settings/mailer (instance_settings).
# Local catcher (opt-in): make mailpit → save smtp://mailer:1025 in Admin → Mailer.
# See docs/ops/MAILPIT.md. Never point production at Mailpit.
MAILER_DSN=null://null
###< symfony/mailer ###

# -----------------------------------------------------------------------------
# Mailpit (Compose profile `mail`) — local SMTP catcher, not for production
# -----------------------------------------------------------------------------
# Start: make mailpit   |   UI: http://localhost:${MAILPIT_UI_PORT}
# Host SMTP port is only for tools on the host; PHP uses smtp://mailer:1025.
# Host ports avoid common 1025/8025 clashes with other local stacks.
MAILPIT_UI_PORT=18027
MAILPIT_SMTP_PORT=1027

# -----------------------------------------------------------------------------
# AuthKit social login
# -----------------------------------------------------------------------------
# Credentials live in auth_kit_social_credential — manage via Administration → Social login.
# AuthKit ≥ 1.15 encrypts client_secret (+ linked-account tokens) with Halite; run
# `bin/console doctrine:encrypt:database --force` once after upgrading if rows are still plaintext.
# mode is enabled in config/packages/nowo_auth_kit.yaml; buttons appear only after
# at least one enabled credential exists.
# Register redirect URIs at the IdP matching DEFAULT_URI + /login/social/{provider}/check
# (and /{locale}/… for non-default locales).


###> nowo-tech/beacon-bundle ###
# Empty disables Envelope reporting to a Symfony Beacon server (REQ-BEACON).
# Format: {scheme}://{public_key}:{secret}@{host}[:{port}]/{project_id}
# Example (Docker → Beacon HTTP ingest):
#   BEACON_DSN=http://PUBLIC:SECRET@host.docker.internal:9081/1
# Optional release tag (git SHA / app version) attached when send.release is true.
BEACON_DSN=
BEACON_RELEASE=
###< nowo-tech/beacon-bundle ###

# -----------------------------------------------------------------------------
# SMS provider (docs/product/SMS.md) — default disabled
# -----------------------------------------------------------------------------
# SMS_PROVIDER=null | sms_bridge
SMS_PROVIDER=null
SMS_BRIDGE_BASE_URL=
SMS_BRIDGE_AUTH_TOKEN=
SMS_BRIDGE_ACCOUNT_SID=
SMS_BRIDGE_API_MODE=twilio
SMS_BRIDGE_FROM=
SMS_BRIDGE_DEVICE_ID=
