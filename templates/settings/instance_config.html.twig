{% extends 'base.html.twig' %}

{% block title %}{{ 'settings.instance_config.title'|trans }} — {{ site_appearance.brandName }}{% endblock %}

{% block body %}
<div class="mb-6">
    <p class="text-sm"><a class="text-[var(--color-moss)] no-underline hover:underline" href="{{ path('admin_hub') }}">{{ 'admin.hub.title'|trans }}</a></p>
    <h1 class="mt-2 font-[family-name:var(--font-display)] text-3xl font-bold">{{ 'settings.instance_config.title'|trans }}</h1>
    <p class="mt-1 text-sm text-[var(--color-ink)]/65">{{ 'settings.instance_config.intro'|trans }}</p>
</div>

<section class="panel" data-testid="instance-config-portability">
    <h2 class="mb-2 text-lg font-semibold">{{ 'settings.instance_config.title'|trans }}</h2>
    <p class="mb-3 text-sm text-[var(--color-ink)]/60">{{ 'settings.instance_config.intro'|trans }}</p>

    <div
        data-controller="tabs"
        data-tabs-active-tab-value="instance-config-export"
        class="grid gap-3"
    >
        <nav
            role="tablist"
            aria-label="{{ 'settings.instance_config.tabs_label'|trans|e('html_attr') }}"
            class="flex h-auto w-full flex-wrap justify-start gap-1 border-b border-[var(--color-sand)]"
        >
            <button
                type="button"
                id="tab-instance-config-export"
                data-action="click->tabs#open"
                data-tabs-target="trigger"
                data-tab-id="instance-config-export"
                role="tab"
                aria-controls="tab-instance-config-export-panel"
                aria-selected="true"
                data-active
                data-testid="instance-config-export"
                class="relative inline-flex min-w-10 items-center justify-center px-2.5 py-1.5 text-sm font-medium text-[var(--color-ink)]/55 transition-colors hover:text-[var(--color-ink)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-moss)] data-[active]:text-[var(--color-ink)] data-[active]:after:absolute data-[active]:after:inset-x-0 data-[active]:after:bottom-[-1px] data-[active]:after:h-0.5 data-[active]:after:bg-[var(--color-ink)]"
            >{{ 'settings.instance_config.tab_export'|trans }}</button>
            <button
                type="button"
                id="tab-instance-config-import"
                data-action="click->tabs#open"
                data-tabs-target="trigger"
                data-tab-id="instance-config-import"
                role="tab"
                aria-controls="tab-instance-config-import-panel"
                aria-selected="false"
                data-testid="instance-config-import"
                class="relative inline-flex min-w-10 items-center justify-center px-2.5 py-1.5 text-sm font-medium text-[var(--color-ink)]/55 transition-colors hover:text-[var(--color-ink)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-moss)] data-[active]:text-[var(--color-ink)] data-[active]:after:absolute data-[active]:after:inset-x-0 data-[active]:after:bottom-[-1px] data-[active]:after:h-0.5 data-[active]:after:bg-[var(--color-ink)]"
            >{{ 'settings.instance_config.tab_import'|trans }}</button>
        </nav>

        <div
            id="tab-instance-config-export-panel"
            data-tabs-target="tab"
            data-tab-id="instance-config-export"
            role="tabpanel"
            aria-labelledby="tab-instance-config-export"
            data-active
            data-state="active"
        >
            <div class="grid gap-3 pt-1">
                <p class="text-sm text-[var(--color-ink)]/60">{{ 'settings.instance_config.export_help'|trans }}</p>
                <div>
                    <a class="btn-primary inline-block no-underline" href="{{ path('settings_instance_config_export') }}" data-testid="instance-config-download">{{ 'settings.instance_config.export'|trans }}</a>
                </div>
            </div>
        </div>

        <div
            id="tab-instance-config-import-panel"
            data-tabs-target="tab"
            data-tab-id="instance-config-import"
            role="tabpanel"
            aria-labelledby="tab-instance-config-import"
            data-state="inactive"
            class="hidden"
            hidden
        >
            <div class="grid gap-3 pt-1">
                <p class="mb-0 text-sm text-[var(--color-ink)]/60">{{ 'settings.instance_config.import_help'|trans }}</p>
                {{ form_start(importForm, {attr: {class: 'flex flex-wrap items-end gap-3'}}) }}
                    {% for field in importForm %}
                        {% if not field.rendered and 'hidden' not in field.vars.block_prefixes %}
                            {{ form_row(field) }}
                        {% endif %}
                    {% endfor %}
                    <button type="submit" class="btn-primary" data-testid="instance-config-import-submit">{{ 'settings.instance_config.import'|trans }}</button>
                    {% include 'form/_fields.html.twig' with {form: importForm} only %}
                {{ form_end(importForm, {render_rest: false}) }}
            </div>
        </div>
    </div>
</section>
{% endblock %}
