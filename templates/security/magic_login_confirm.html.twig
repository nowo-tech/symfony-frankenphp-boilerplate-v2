{% extends 'layouts/guest_shell.html.twig' %}

{% block title %}{{ 'magic_login.confirm.title'|trans({}, 'NowoAuthKitBundle') }} — {{ site_appearance.brandName }}{% endblock %}

{% block body %}
    <div class="guest-auth">
        <h1>{{ 'magic_login.confirm.heading'|trans({}, 'NowoAuthKitBundle') }}</h1>
        <p>{{ 'magic_login.confirm.help'|trans({}, 'NowoAuthKitBundle') }}</p>
        {{ form_start(magic_login_confirm_form, {attr: {class: 'guest-auth__form', 'data-turbo': 'false'}}) }}
            {{ form_widget(magic_login_confirm_form) }}
            <button type="submit" class="btn-primary w-full">{{ 'magic_login.confirm.submit'|trans({}, 'NowoAuthKitBundle') }}</button>
        {{ form_end(magic_login_confirm_form) }}
        <p class="guest-auth__footer">
            <a href="{{ path(login_route, auth_kit_route_params()) }}">{{ 'magic_login.confirm.back_to_login'|trans({}, 'NowoAuthKitBundle') }}</a>
        </p>
    </div>
{% endblock %}
