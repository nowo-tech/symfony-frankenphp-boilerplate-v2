{#
  Server-side table pagination: the app's table pills (layouts/partials/_pagination.html.twig, also the UiKit
  `pagination` theme partial of the kit list scaffolds). Never DataTables paging.
#}
{% include 'layouts/partials/_pagination.html.twig' with {
    pagination: pagination,
    item_count: item_count,
    route: route|default(null),
    route_params: route_params|default({}),
    query: query|default({}),
    nav_label: nav_label|default('pagination.nav'),
    trans_domain: trans_domain|default('NowoUiKitBundle'),
    nav_trans_domain: nav_trans_domain|default('messages'),
    framework: framework|default('tailwind'),
} only %}
