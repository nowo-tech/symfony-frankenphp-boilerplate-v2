{# Nowo Shell host layout for MaintenanceMode ops panel.
   Bundle pages extend nowo_maintenance_mode_layout_template and fill {% block body %}.
   Panel uses its own password gate (PUBLIC_ACCESS) — guest shell, not dashboard. #}
{% extends 'layouts/guest_shell.html.twig' %}

{% set brand = site_appearance.brandName|default(brandName|default('Nowo Shell')) %}

{% block title %}{{ brand }} — {{ 'nav.maintenance'|trans }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ vite_entry_link_tags('kit-admin') }}
    {% include 'kit/_kit_admin_styles.html.twig' %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ vite_entry_script_tags('kit-admin') }}
{% endblock %}

{% block guest_shell_width %}max-w-4xl{% endblock %}
