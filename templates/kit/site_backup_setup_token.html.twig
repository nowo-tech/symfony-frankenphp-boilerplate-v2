{#
  Friendly SiteBackup token gate (nowo_site_backup.web_ui.templates.setup_token, REQ-SETUP-009): the bundle's auth page
  (HTTP 403, guest layout) with the app's illustration, copy and field. page.form is the bundle's GET form (field
  `token`, no CSRF, action = setup prefix); pathPrefix feeds the how-to example. How-to steps stay behind a disclosure.
#}
{% extends '@NowoSiteBackupBundle/setup/token.html.twig' %}

{% block nowo_ui_document_title %}{{ 'setup.token.title'|trans }}{% endblock %}

{% block nowo_ui_content %}
    {% set tokenForm = page.form %}
    <div class="setup-token-gate" data-testid="setup-token-gate">
        <div class="setup-token-gate__art">
            <img class="setup-token-gate__img" src="{{ asset('illustrations/error-403.png') }}" width="1024" height="682" alt="{{ 'error.403.image_alt'|trans }}" decoding="async">
        </div>

        <h1 class="setup-token-gate__title">{{ 'setup.token.title'|trans }}</h1>
        <p class="setup-token-gate__lead">{{ 'setup.token.lead'|trans }}</p>

        <div class="setup-token-gate__panel">
            <h2 id="setup-token-heading" class="setup-token-gate__panel-title">{{ 'setup.token.field_label'|trans }}</h2>
            {% if tokenForm %}
                {% form_theme tokenForm with ['form/app_theme.html.twig'] %}
                {{ form_start(tokenForm, {attr: {class: 'setup-token-gate__form'}}) }}
                    <div class="setup-token-gate__row">
                        {# The placeholder is translated here: translation_domain false keeps the theme from translating it again. #}
                        {{ form_row(tokenForm.token, {
                            label: false,
                            translation_domain: false,
                            row_attr: {class: 'setup-token-gate__field'},
                            attr: {
                                class: 'input setup-token-gate__input',
                                autocomplete: 'off',
                                autocapitalize: 'off',
                                spellcheck: 'false',
                                'aria-labelledby': 'setup-token-heading',
                                placeholder: 'setup.token.field_placeholder'|trans,
                            },
                        }) }}
                        <button type="submit" class="setup-token-gate__submit">{{ 'setup.token.submit'|trans }}</button>
                    </div>
                {{ form_end(tokenForm) }}
            {% endif %}

            <details class="setup-token-gate__howto" data-testid="setup-token-howto">
                <summary>{{ 'setup.token.howto'|trans }}</summary>
                <ol class="setup-token-gate__steps">
                    <li>{{ 'setup.token.step_env'|trans }}</li>
                    <li>{{ 'setup.token.step_url'|trans({'%path%': pathPrefix ~ '?token=…'}) }}</li>
                    <li>{{ 'setup.token.step_header'|trans }}</li>
                </ol>
            </details>
        </div>
    </div>
{% endblock %}
