{% extends 'base.html.twig' %}

{% block title %}{{ 'users.activity.title'|trans }} — {{ user.displayName }}{% endblock %}

{% block body %}
<div class="mb-6">
    <a href="{{ path('admin_users') }}" class="text-sm no-underline">{{ 'users.back'|trans }}</a>
    <h1 class="mt-2 font-[family-name:var(--font-display)] text-3xl font-bold">{{ 'users.activity.title'|trans }}</h1>
    <p class="mt-1 text-sm text-[var(--color-ink)]/65">
        {{ 'users.activity.intro'|trans({'%name%': user.displayName, '%email%': user.email}) }}
    </p>
</div>

<section class="panel">
    {% include 'admin/_audit_timeline.html.twig' with {
        form_action: path('admin_users_activity', {id: user.uuid}),
        reset_path: path('admin_users_activity', {id: user.uuid}),
        title_key: 'users.activity.timeline_title',
        intro_key: 'users.activity.audit_intro',
        empty_key: 'users.activity.audit_empty',
        audit_actions: userAuditActions,
        audit_filter: userAuditFilter,
        audit_entries: actions,
        timeline_id: 'user-audit-timeline',
        entry_testid: 'user-audit-entry'
    } only %}
</section>
{% endblock %}
