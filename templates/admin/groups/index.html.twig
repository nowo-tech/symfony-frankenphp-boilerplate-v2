{% extends 'base.html.twig' %}

{% block title %}{{ 'groups.title'|trans }} — {{ site_appearance.brandName }}{% endblock %}

{% block body %}
<div class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <div>
        <h1 class="font-[family-name:var(--font-display)] text-3xl font-bold">{{ 'groups.title'|trans }}</h1>
        <p class="mt-1 text-sm text-[var(--color-ink)]/65">{{ 'groups.intro'|trans }}</p>
    </div>
    {% embed 'shared/_confirm_dialog.html.twig' with {
        custom_form: true,
        dialog_modifier: 'confirm-dialog--md',
        open_on_connect: open_create,
        aria_labelledby: 'group-create-dialog-title',
    } %}
        {% block trigger %}
            <button
                type="button"
                class="btn-primary"
                data-action="confirm-dialog#open"
                data-testid="admin-group-create"
            >{{ 'groups.create'|trans }}</button>
        {% endblock %}
        {% block form %}
            {{ form_start(createForm, {attr: {class: 'confirm-dialog__panel'}}) }}
                <div class="confirm-dialog__header">
                    <h2 id="group-create-dialog-title" class="confirm-dialog__title">{{ 'groups.create'|trans }}</h2>
                    <p class="confirm-dialog__body">{{ 'groups.intro'|trans }}</p>
                </div>
                <div class="confirm-dialog__content">
                    {% include 'form/_fields.html.twig' with {form: createForm} only %}
                </div>
                <div class="confirm-dialog__actions">
                    <button type="button" class="btn-ghost" data-confirm-dialog-close>{{ 'groups.cancel'|trans }}</button>
                    <button class="btn-primary" type="submit" data-testid="admin-group-create-submit">{{ 'groups.create'|trans }}</button>
                </div>
            {{ form_end(createForm) }}
        {% endblock %}
    {% endembed %}
</div>

{{ form_start(filter_form, {attr: {class: 'mb-4 flex flex-wrap items-end gap-2'}}) }}
    {% for field in filter_form %}
        {% if not field.rendered and 'hidden' not in field.vars.block_prefixes %}
            {{ form_row(field, {
                label: false,
                attr: {
                    class: 'input min-w-56 flex-1',
                    autocomplete: 'off',
                },
                row_attr: {class: 'grow min-w-56'},
            }) }}
        {% endif %}
    {% endfor %}
    <button class="btn-ghost" type="submit">{{ 'common.filter'|trans }}</button>
    <a class="btn-ghost no-underline" href="{{ path('admin_groups') }}">{{ 'common.clear_filters'|trans }}</a>
    {% include 'form/_fields.html.twig' with {form: filter_form} only %}
{{ form_end(filter_form, {render_rest: false}) }}

<section class="panel overflow-x-auto">
    <table class="w-full text-left text-sm">
        <thead>
            <tr class="border-b border-[var(--color-sand)] text-[var(--color-ink)]/55">
                <th class="px-2 py-2 font-medium">{{ 'groups.col.group'|trans }}</th>
                <th class="px-2 py-2 font-medium">{{ 'groups.col.slug'|trans }}</th>
                <th class="px-2 py-2 font-medium">{{ 'groups.col.members'|trans }}</th>
                <th class="px-2 py-2 font-medium">{{ 'groups.col.description'|trans }}</th>
                <th class="px-2 py-2 font-medium">{{ 'groups.col.audit'|trans }}</th>
                <th class="px-2 py-2 font-medium">{{ 'groups.col.actions'|trans }}</th>
            </tr>
        </thead>
        <tbody>
            {% for group in groups %}
                <tr class="row-hover border-b border-[var(--color-sand)]/70 last:border-0">
                    <td class="px-2 py-3">
                        <a class="font-medium no-underline" href="{{ path('admin_groups_show', {id: group.uuid}) }}">{{ group.name }}</a>
                    </td>
                    <td class="px-2 py-3 text-[var(--color-ink)]/75">{{ group.slug }}</td>
                    <td class="px-2 py-3">
                        <span class="badge bg-[var(--color-sand)] text-[var(--color-ink)]/75">
                            {{ 'groups.member_count'|trans({'%count%': member_counts[group.id]|default(0)}) }}
                        </span>
                    </td>
                    <td class="px-2 py-3 text-[var(--color-ink)]/65">
                        {% if group.description %}
                            <span class="line-clamp-2">{{ group.description }}</span>
                        {% else %}
                            <span class="text-[var(--color-ink)]/40">{{ 'common.na'|trans }}</span>
                        {% endif %}
                    </td>
                    <td class="px-2 py-3 align-top">
                        {% include 'shared/_audit_meta.html.twig' with {entity: group} only %}
                    </td>
                    <td class="px-2 py-3">
                        <div class="flex flex-wrap items-center gap-2">
                            <a class="btn-ghost btn-sm no-underline" href="{{ path('admin_groups_show', {id: group.uuid}) }}">{{ 'groups.open'|trans }}</a>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td class="px-2 py-4 text-[var(--color-ink)]/55" colspan="6">{{ 'groups.empty'|trans }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</section>
{% endblock %}
