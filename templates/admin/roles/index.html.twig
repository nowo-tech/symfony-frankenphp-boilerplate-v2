{% extends 'base.html.twig' %}

{% block title %}{{ 'roles.title'|trans }} — {{ site_appearance.brandName }}{% endblock %}

{% block body %}
{% embed 'admin/_list_page.html.twig' with {
    title: 'roles.title',
    intro: 'roles.intro',
    create_route: 'admin_roles_new',
    create_label: 'roles.create',
    search_route: 'admin_roles',
    filter_form: filter_form,
} %}
    {% block header_actions %}
        <div class="flex flex-wrap gap-2">
            <a class="btn-ghost no-underline" href="{{ path('admin_permissions') }}">{{ 'roles.link_permissions'|trans }}</a>
            <a class="btn-primary no-underline" href="{{ path('admin_roles_new') }}">{{ 'roles.create'|trans }}</a>
        </div>
    {% endblock %}
    {% block table_head %}
        <thead>
            <tr class="border-b border-[var(--color-sand)] text-[var(--color-ink)]/55">
                <th class="px-2 py-2 font-medium">{{ 'roles.col.role'|trans }}</th>
                <th class="px-2 py-2 font-medium">{{ 'roles.col.code'|trans }}</th>
                <th class="px-2 py-2 font-medium">{{ 'roles.col.status'|trans }}</th>
                <th class="px-2 py-2 font-medium">{{ 'roles.col.permissions'|trans }}</th>
                <th class="px-2 py-2 font-medium">{{ 'roles.col.users'|trans }}</th>
                <th class="px-2 py-2 font-medium">{{ 'roles.col.actions'|trans }}</th>
            </tr>
        </thead>
    {% endblock %}
    {% block table_body %}
        <tbody>
            {% for row in roles %}
                {% set role = row.role %}
                <tr class="row-hover border-b border-[var(--color-sand)]/70 last:border-0" data-testid="admin-role-row">
                    <td class="px-2 py-3">
                        <a class="font-medium no-underline" href="{{ path('admin_roles_show', {id: role.uuid}) }}">{{ role|rbac_role_name }}</a>
                        {% set role_description = role|rbac_role_description %}
                        {% if role_description %}
                            <div class="mt-1 line-clamp-2 text-xs text-[var(--color-ink)]/55">{{ role_description }}</div>
                        {% endif %}
                    </td>
                    <td class="px-2 py-3">
                        <code class="text-xs">{{ role.code }}</code>
                    </td>
                    <td class="px-2 py-3">
                        {% if role.enabled %}
                            <span class="badge bg-[var(--color-moss)]/15 text-[var(--color-moss)]">{{ 'roles.status.enabled'|trans }}</span>
                        {% else %}
                            <span class="badge bg-[var(--color-alert)]/15 text-[var(--color-alert)]">{{ 'roles.status.disabled'|trans }}</span>
                        {% endif %}
                        {% if role.system %}
                            <span class="badge bg-[var(--color-sand)] text-[var(--color-ink)]/65">{{ 'roles.status.system'|trans }}</span>
                        {% endif %}
                    </td>
                    <td class="px-2 py-3">{{ row.permissionCount }}</td>
                    <td class="px-2 py-3">{{ row.userCount }}</td>
                    <td class="px-2 py-3">
                        <a class="btn-ghost btn-sm no-underline" href="{{ path('admin_roles_show', {id: role.uuid}) }}">{{ 'roles.open'|trans }}</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td class="px-2 py-4 text-[var(--color-ink)]/55" colspan="6">{{ 'roles.empty'|trans }}</td>
                </tr>
            {% endfor %}
        </tbody>
    {% endblock %}
{% endembed %}
{% endblock %}
